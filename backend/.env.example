# ============================================================
# 配置模板 — 复制本文件为 .env 后填入你自己的值
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ⚠️ .env 已在 .gitignore 中，请勿把真实的 .env 提交或随包分发
# ============================================================

# ---------- 讯飞星火 / MaaS 大模型 ----------
# ⚠️ 下面凡是有默认值的键（如 SPARK_API_BASE、SPARK_MODEL、SPARK_THINKING、
# MYSQL_PASSWORD），**不要写成空值**：dotenv 读到空值也算"设置过"，
# 会把 settings.py 里的默认值覆盖成空字符串（曾导致
# Invalid URL '/chat/completions': No scheme supplied）。
# 不需要改默认值就整行删掉，不要留 `KEY=`。
#
# 在讯飞开放平台 console.xfyun.cn 创建应用后获取
SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=

# OpenAI 兼容接口地址。
#   星火开放平台：https://spark-api-open.xf-yun.com/v1
#   星辰 MaaS（华北）：https://maas-api.cn-huabei-1.xf-yun.com/v2
SPARK_API_BASE=https://spark-api-open.xf-yun.com/v1

# 模型名：领了哪个模型的试用包就填哪个（4.0Ultra / max-32k / pro-128k / generalv3.5 / lite ...）
SPARK_MODEL=4.0Ultra

# 星辰 MaaS 平台用独立 Bearer Key；填了它会优先于上面的 key:secret，不用可留空
SPARK_BEARER_TOKEN=

# 思考模式：X2.5 系列"先思考再回答"，首字延迟 3 秒以上但质量略升。
# 默认 false（关闭）以获得更快的首字响应；填 true 打开
SPARK_THINKING=false

# ---------- MySQL ----------
# 后端启动时会自动创建下面这个库和全部数据表，无需手动建库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=agents
