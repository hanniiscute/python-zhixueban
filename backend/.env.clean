# ============================================================
# 交付版 .env —— 不含任何真实密钥，由「准备交付.bat」自动套用
#
# ⚠️ SPARK_API_BASE / SPARK_MODEL / SPARK_THINKING 这几项在
# config/settings.py 里有默认值，**千万不要**在这里写成空值：
# dotenv 读到空值也算"设置过"，会把默认值覆盖成空字符串 ——
# 曾导致报错 Invalid URL '/chat/completions': No scheme supplied。
# 想改默认值就直接填新值；不写这一行，就是用默认值。
# ============================================================

SPARK_APP_ID=
SPARK_API_KEY=
SPARK_API_SECRET=
SPARK_BEARER_TOKEN=

# 本机 MySQL 密码（不是密钥；留空会导致默认值被空串覆盖、连不上库）
MYSQL_PASSWORD=123456
